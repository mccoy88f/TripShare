# ─── Dominio e HTTPS ──────────────────────────────────────────────
# Dominio pubblico: Caddy ottiene e rinnova da solo il certificato Let's Encrypt.
DOMAIN=trip.example.com
# Email per gli avvisi di Let's Encrypt (facoltativa).
ACME_EMAIL=

# ─── Segreti (generali con i comandi indicati) ────────────────────
# openssl rand -base64 48
AUTH_SECRET=
# openssl rand -base64 32   (32 byte: cifra le chiavi API salvate nel database)
ENCRYPTION_KEY=
# openssl rand -hex 24
POSTGRES_PASSWORD=

# ─── Primo avvio ──────────────────────────────────────────────────
# Riceve il link per impostare la password del super admin.
SUPERADMIN_EMAIL=
APP_NAME=TripShare

# ─── Email (SMTP) ─────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
# true per TLS implicito (di solito porta 465). Se vuoto: true solo con la porta 465.
SMTP_SECURE=
# Solo se il server richiede l'autenticazione.
SMTP_USER=
SMTP_PASSWORD=
# Facoltativa. Se vuota: "TripShare" <SMTP_USER> se SMTP_USER è un'email,
# altrimenti "TripShare" <noreply@DOMAIN>.
SMTP_FROM=
# false solo per server con certificato self-signed.
SMTP_TLS_REJECT_UNAUTHORIZED=

# ─── OpenRouter ───────────────────────────────────────────────────
# Facoltativa: valore iniziale, modificabile dal pannello admin.
OPENROUTER_API_KEY=

# ─── Solo sviluppo locale (pnpm dev) ──────────────────────────────
# APP_URL=http://localhost:5173
# DATABASE_URL=postgres://tripshare:tripshare@localhost:5432/tripshare
# REDIS_URL=redis://localhost:6379
