# ─── Dominio e HTTPS ──────────────────────────────────────────────
# Dominio pubblico: Caddy ottiene e rinnova da solo il certificato Let's Encrypt.
DOMAIN=trip.example.com
# Email per gli avvisi di Let's Encrypt (facoltativa).
ACME_EMAIL=

# ─── Segreti (generali con i comandi indicati) ────────────────────
# openssl rand -base64 48
AUTH_SECRET=
# openssl rand -base64 32   (32 byte: cifra le chiavi API salvate nel database)
ENCRYPTION_KEY=
# openssl rand -hex 24
POSTGRES_PASSWORD=

# ─── Primo avvio ──────────────────────────────────────────────────
# Riceve il link per impostare la password del super admin.
SUPERADMIN_EMAIL=
APP_NAME=TripShare

# ─── Email (SMTP) ─────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
# true per TLS implicito (di solito porta 465). Se vuoto: true solo con la porta 465.
SMTP_SECURE=
# Solo se il server richiede l'autenticazione.
SMTP_USER=
SMTP_PASSWORD=
# Facoltativa. Se vuota: "TripShare" <SMTP_USER> se SMTP_USER è un'email,
# altrimenti "TripShare" <noreply@DOMAIN>.
SMTP_FROM=
# false solo per server con certificato self-signed.
SMTP_TLS_REJECT_UNAUTHORIZED=

# ─── AI: OpenRouter e/o Google Gemini ─────────────────────────────
# Facoltative: valori iniziali, modificabili dal pannello admin (dove si sceglie anche il
# provider usato con la chiave centrale e i modelli per ogni compito).
OPENROUTER_API_KEY=
# Chiave di Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Facoltativa: indirizzo alternativo delle API OpenRouter (proxy aziendale o test).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ─── Solo sviluppo locale (pnpm dev) ──────────────────────────────
# APP_URL=http://localhost:5173
# DATABASE_URL=postgres://tripshare:tripshare@localhost:5432/tripshare
# REDIS_URL=redis://localhost:6379
