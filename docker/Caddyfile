# SITE_ADDRESS: il dominio (HTTPS automatico con Let's Encrypt) oppure ":80" dietro un altro
# proxy che gestisce già HTTPS, come Traefik in Coolify.
{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
		-Server
	}

	# Aggiornamenti in tempo reale (SSE): niente buffer, i messaggi arrivano subito.
	handle /api/events {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Tutto il resto (index.html per ogni pagina dell'app, sw.js, manifest) va sempre
		# riconvalidato, così dopo un aggiornamento non resta in uso una versione vecchia.
		@fresh not path /assets/*
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
