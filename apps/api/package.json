{
  "name": "@tripshare/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@tripshare/db": "workspace:*",
    "@tripshare/shared": "workspace:*",
    "@trpc/server": "^11.19.0",
    "better-auth": "^1.7.7",
    "bullmq": "^6.3.12",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.16",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "exports": {
    "./router": "./src/routers/index.ts"
  }
