{
  "name": "tripshare",
  "private": true,
  "version": "0.1.0",
  "description": "TripShare: viaggi di gruppo e spese condivise",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" run \"/^dev/\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @tripshare/db generate",
    "db:migrate": "pnpm --filter @tripshare/db migrate",
    "schema:trip": "pnpm --filter @tripshare/shared schema:trip",
    "dev:services": "docker compose -f docker-compose.dev.yml up -d"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "type": "module"
}
