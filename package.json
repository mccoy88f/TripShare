{
  "name": "tripshare",
  "private": true,
  "version": "0.1.0",
  "description": "TripShare: viaggi di gruppo e spese condivise",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @tripshare/db generate",
    "db:migrate": "pnpm --filter @tripshare/db migrate",
    "schema:trip": "pnpm --filter @tripshare/shared schema:trip"
  }
}
